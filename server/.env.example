# =========================================================================
# CONFIGURACIÓN DE ENVÍO DE CORREOS ELECTRÓNICOS (SMTP)
# =========================================================================
# Si estos campos están vacíos, el sistema correrá en "Modo Simulación (Sandbox)"
# para desarrollo. Para enviar correos reales, descomenta y completa:
#
# --- Ejemplo 1: Gmail (Requiere "Contraseña de Aplicación" de 16 caracteres) ---
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="tu_correo@gmail.com"
# SMTP_PASS="abcd efgh ijkl mnop"
# SMTP_FROM="\"Tribunal Electoral Sindicato\" <tu_correo@gmail.com>"
#
# --- Ejemplo 2: Microsoft 365 / Outlook ---
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="elecciones@sindicato.org"
# SMTP_PASS="tu_contraseña"
# SMTP_FROM="\"Tribunal Electoral\" <elecciones@sindicato.org>"
#
# --- Ejemplo 3: Brevo (Sendinblue) / SendGrid / Mailgun / AWS SES ---
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="tu_usuario_smtp"
# SMTP_PASS="tu_smtp_key"
# SMTP_FROM="\"Comisión Electoral\" <notificaciones@sindicato.org>"
