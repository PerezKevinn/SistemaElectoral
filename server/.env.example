# ==============================================================================
# VARIABLES DE ENTORNO - SISTEMA ELECTORAL
# ==============================================================================
# Copia este archivo como .env y completa los valores correspondientes
# según el entorno (STAGING / PRODUCCIÓN).
# ==============================================================================

PORT=4000
NODE_ENV=production

# Clave secreta para firma de Tokens JWT (Usa una cadena larga y aleatoria)
JWT_CHALLENGE_SECRET="super_secret_challenge_key_jwt_random_987654"
JWT_SECRET="c2VjdXJlX2VsZWN0aW9uX2p3dF9zZWNyZXRfa2V5XzIwMjY="

# ------------------------------------------------------------------------------
# SUPABASE PROYECTO 1: CENSO Y SOLICITUDES DE REGISTRO
# (En Staging usar proyecto de pruebas; en Producción usar proyecto oficial)
# ------------------------------------------------------------------------------
SUPABASE_CENSO_URL="https://tu-proyecto-censo.supabase.co"
SUPABASE_CENSO_SERVICE_KEY="tu_service_role_secret_key_censo"

# ------------------------------------------------------------------------------
# SUPABASE PROYECTO 2: URNA DIGITAL Y AUDITORÍA CRIPTOGRÁFICA
# (En Staging usar proyecto de pruebas; en Producción usar proyecto oficial)
# ------------------------------------------------------------------------------
SUPABASE_URNA_URL="https://tu-proyecto-urna.supabase.co"
SUPABASE_URNA_SERVICE_KEY="tu_service_role_secret_key_urna"

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_tu_api_key_de_resend"
SMTP_FROM="Altum Software Solutions <elecciones@altumsoftware.solutions>"

# ------------------------------------------------------------------------------
# URLS DE ACCESO DEL FRONTEND (Para enlaces en correos y CORS)
# - STAGING:    https://pruebas.elecciones.altumsoftware.solutions
# - PRODUCCIÓN: https://elecciones.altumsoftware.solutions
# ------------------------------------------------------------------------------
CLIENT_URL="https://elecciones.altumsoftware.solutions"
FRONTEND_URL="https://elecciones.altumsoftware.solutions"
APP_URL="https://elecciones.altumsoftware.solutions"

# ------------------------------------------------------------------------------
# CREDENCIALES DE SUPER ADMINISTRADOR DE INFRAESTRUCTURA
# ------------------------------------------------------------------------------
SUPER_ADMIN_DOCUMENTO="superadmin"
SUPER_ADMIN_PASSWORD="TuPasswordSeguro2026!"
SUPER_ADMIN_NOMBRE="Super Administrador Principal"
SUPER_ADMIN_CARGO="Administrador General de Infraestructura"
